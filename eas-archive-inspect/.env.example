# Giriş ekranı — Gizlilik / KVKK WebView (tam URL; yoksa finanssepeti.net yolları kullanılır)
# EXPO_PUBLIC_LEGAL_PRIVACY_URL=https://finanssepeti.net/gizlilik
# EXPO_PUBLIC_LEGAL_KVKK_URL=https://finanssepeti.net/kvkk

EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=your_new_site_key_here
EXPO_PUBLIC_FUNCTIONS_BASE_URL=https://us-central1-your-project-id.cloudfunctions.net
# Uygulama içi <Image> logosu: her zaman mobileapp/logo/app-icon.png (bundled).
# Bu değişken PDF/WebView gibi yerlerde resolveBrandLogoUri için kullanılır; 404 ise SVG fallback.
EXPO_PUBLIC_LOGO_URL=https://www.finansepeti.net/logo.png
# Firebase (Harcamalarım Firestore senkron) — Console → Project settings → Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Expo push (dev/prod build): EAS project UUID (eas init / expo.dev)
EXPO_PUBLIC_EAS_PROJECT_ID=
# Emtia fiyatları (Altın/Gümüş gram TL, Petrol USD) — webdeki emtia sembol/kısa kod ile aynı backend JSON
EXPO_PUBLIC_EMITIA_QUOTES_URL=
# TEFAS YAT fon listesi — mobileapp klasöründe npm run tefas-service; PC IP:port (app.json usesCleartextTraffic kendi derlemenizde)
# Expo Go: http://192.168.x.x gibi adresler otomatik yok sayılır — yalnızca tefas.gov.tr / geçidi denenir.
# Yereli yine zorlamak için: EXPO_PUBLIC_TEFAS_FORCE_HTTP_LOCAL=1
EXPO_PUBLIC_TEFAS_BASE_URL=
# Son başarılı YAT listesi TTL (gün); TEFAS düşünce cihaz önbelleği kullanılır — varsayılan 14
# EXPO_PUBLIC_TEFAS_LOCAL_CACHE_DAYS=
# EXPO_PUBLIC_TEFAS_FORCE_HTTP_LOCAL=
# Yahoo + TEFAS ortak ağ geçidi (çok kullanıcıda tek çıkış; sunucuda Redis önerilir) — npm run market-gateway
# Örnek: https://api.sizin-domain.com veya geliştirme: http://192.168.1.5:8790
EXPO_PUBLIC_MARKET_GATEWAY_URL=
# Canlı yayınlar — tam URL veya yalnız yol (ör. /tr/canli-yayin). Varsayılan: https://finanssepeti.net/canliyayin
# EXPO_PUBLIC_CANLI_YAYINLARIM_URL=https://finanssepeti.net/canliyayin
# Jitsi Meet tabanı (uygulama içi yayın). Kendi sunucunuz: https://meet.sizin-domain.com
# EXPO_PUBLIC_JITSI_MEET_BASE_URL=https://meet.jit.si
# Native Jitsi SDK sadece development build'de çalışır (Expo Go'da WebView fallback aktif kalır)
# Kıyasla veri sağlayıcıları:
# AlphaVantage (USDTRY/EURTRY günlük): https://www.alphavantage.co/support/#api-key
EXPO_PUBLIC_ALPHA_VANTAGE_API_KEY=
# MetalPriceAPI (Altın/Gümüş historical, opsiyonel): https://metalpriceapi.com/
EXPO_PUBLIC_METALPRICE_API_KEY=
# Doviz.com API (opsiyonel, erişim anahtarı varsa; yoksa otomatik fallback çalışır)
EXPO_PUBLIC_DOVIZ_API_BASE=https://www.doviz.com/api/v1
EXPO_PUBLIC_DOVIZ_API_KEY=
# Webde çalışan kıyasla motoru (9 varlık hesaplaması için birincil kaynak)
EXPO_PUBLIC_KIYASLA_API_URL=https://finanssepeti.net/api-kiyasla-data.php
# PPF / Vadeli / Enflasyon yıllık varsayılan oranları (ondalık)
EXPO_PUBLIC_KIYASLA_PPF_ANNUAL_RATE=0.43
EXPO_PUBLIC_KIYASLA_VADELI_ANNUAL_RATE=0.47
EXPO_PUBLIC_KIYASLA_ENFLASYON_ANNUAL_RATE=0.39
# Ağ geçidi kapalıysa yerel TEFAS + tefas.gov.tr denemesi (1/true: sadece geçit, hata olursa liste gelmez)
# EXPO_PUBLIC_MARKET_GATEWAY_STRICT_TEFAS=
# Expo tunnel: "remote gone away" hatası için https://dashboard.ngrok.com/ → authtoken
# Windows’ta Kalıcı: Sistem Özellikleri → Ortam Değişkenleri → NGROK_AUTHTOKEN=...
# NGROK_AUTHTOKEN=
