{
  "name": "finansepeti-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/install-teknik-engine.cjs",
    "sync-teknik-engine": "node scripts/install-teknik-engine.cjs",
    "start": "node scripts/start-expo-go.cjs",
    "start:plain": "expo start",
    "start:expo-go": "node scripts/start-expo-go.cjs",
    "expo-go:qr": "node scripts/start-expo-go.cjs --qr-only",
    "qr": "node scripts/start-expo-go.cjs --qr-only",
    "start:expo-go:tunnel": "node scripts/start-expo-go.cjs --tunnel",
    "start:lan": "expo start --lan",
    "start:clear": "expo start -c",
    "start:clear:lan": "expo start -c --lan",
    "tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "tefas-service": "node ./tefas-service/server.mjs",
    "market-gateway": "npm --prefix market-gateway start",
    "forum:prune-spam": "node scripts/prune-forum-spam.cjs",
    "firebase:deploy:rules": "node scripts/deploy-firestore-rules.cjs",
    "eas:build:android": "npx eas-cli@latest build -p android --profile production",
    "eas:build:android:play": "npx eas-cli@latest build -p android --profile production --non-interactive",
    "eas:build:android:preview": "npx eas-cli@latest build -p android --profile preview",
    "crop-app-icon": "node scripts/crop-app-icon.cjs"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.5.52",
    "@expo/vector-icons": "^15.1.1",
    "@giphy/react-native-sdk": "5.0.1",
    "@jitsi/react-native-sdk": "^12.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "1.14.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@react-native-google-signin/google-signin": "10.1.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.3.0",
    "@sayem314/react-native-keep-awake": "1.3.1",
    "expo": "~54.0.34",
    "expo-asset": "~12.0.13",
    "expo-av": "^16.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.10",
    "expo-image-manipulator": "14.0.8",
    "expo-image-picker": "17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-notifications": "^0.32.17",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "firebase": "^11.10.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-background-timer": "https://github.com/jitsi/react-native-background-timer.git#d180dfaa4486ae3ee17d01242db92cb3195f4718",
    "react-native-calendar-events": "https://github.com/jitsi/react-native-calendar-events.git#47f068dedfed7c0f72042e093f688eb11624eb7b",
    "react-native-compressor": "^1.16.0",
    "react-native-default-preference": "https://github.com/jitsi/react-native-default-preference.git#c9bf63bdc058e3fa2aa0b87b1ee1af240f44ed02",
    "react-native-device-info": "12.1.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "1.11.0",
    "react-native-orientation-locker": "https://github.com/jitsi/react-native-orientation-locker.git#fe095651d819cf134624f786b61fc8667862178a",
    "react-native-pager-view": "6.9.1",
    "react-native-performance": "5.1.2",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-sound": "https://github.com/jitsi/react-native-sound.git#ea13c97b5c2a4ff5e0d9bacbd9ff5e4457fe2c3c",
    "react-native-splash-view": "^0.0.21",
    "react-native-svg": "15.12.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-video": "^6.19.2",
    "react-native-webrtc": "124.0.7",
    "react-native-webview": "13.15.0",
    "react-native-worklets-core": "https://github.com/jitsi/react-native-worklets-core.git#8c5dfab2a5907305da8971696a781b60f0f9cb18"
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "2.2.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-background-timer",
          "react-native-calendar-events",
          "react-native-default-preference",
          "react-native-orientation-locker",
          "react-native-webrtc",
          "@amplitude/analytics-react-native",
          "@jitsi/react-native-sdk",
          "@sayem314/react-native-keep-awake"
        ]
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "7.18.6",
    "@babel/plugin-proposal-optional-chaining": "7.21.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
