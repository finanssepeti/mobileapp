# Aşağıdaki 192.168.1.100 = örnek LAN IP. Kendi IPv4 adresiniz farklıysa (ipconfig) hepsinde aynı IP’yi kullanın.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000
# TEFAS: mobileapp klasöründe ayrı terminal → npm run tefas-service (varsayılan port 8765).
# Expo Go: http://192.168.x.x otomatik kullanılmaz; kendi derlemenizde/ngrok HTTPS ile anlamlıdır.
EXPO_PUBLIC_TEFAS_BASE_URL=http://192.168.1.100:8765
EXPO_PUBLIC_TEFAS_PORT=8765
# Yerel http’yi Expo Go’da da denemek için 1 (çoğu cihazda çalışmaz)
# EXPO_PUBLIC_TEFAS_FORCE_HTTP_LOCAL=
# Yerel TEFAS tabanlarını her zaman atla: 1 veya true
# EXPO_PUBLIC_TEFAS_SKIP_LOCAL=
# EXPO_PUBLIC_TEFAS_BASE_URL içindeki hostname’i Metro LAN IP ile değiştir: 1 veya true
# EXPO_PUBLIC_TEFAS_USE_DEV_HOST=
# Yahoo + TEFAS ortak geçit (HTTPS önerilir) — npm run market-gateway. Örnek: https://api.sizin-domain.com
EXPO_PUBLIC_MARKET_GATEWAY_URL=
# 1 veya true ise TEFAS yalnızca geçitten; geçit hata verirse liste gelmez
# EXPO_PUBLIC_MARKET_GATEWAY_STRICT_TEFAS=
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=your_new_site_key_here
EXPO_PUBLIC_FUNCTIONS_BASE_URL=https://us-central1-your-project-id.cloudfunctions.net
# Uygulama içi giriş/profil logosu: logo/app-icon.png (bundled). Bu satır çoğunlukla PDF/WebView için.
EXPO_PUBLIC_LOGO_URL=https://www.finansepeti.net/logo.png
# Firebase (Harcamalarım Firestore) — Console → Project settings → Web app
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyAuBrNSd6HPNeWNpjfQQjK-cs8H2mn_X6s
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=finans-sepeti.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=finans-sepeti
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=finans-sepeti.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=25944539327
EXPO_PUBLIC_FIREBASE_APP_ID=1:25944539327:web:ceac9814113c60b8b8c60a
# Expo push token (EAS): npx eas init veya expo.dev → Project → Project ID
EXPO_PUBLIC_EAS_PROJECT_ID=e255bb9a-c0e6-474b-896f-4ffcebd341c9
# Emtia fiyatları (opsiyonel backend JSON)
EXPO_PUBLIC_EMITIA_QUOTES_URL=
# Expo tunnel / ngrok (isteğe bağlı)
# NGROK_AUTHTOKEN=
